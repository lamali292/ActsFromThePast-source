<Project Sdk="Microsoft.NET.Sdk">
    <!--
        Dread-mode Dominions. This is a SEPARATE assembly on purpose: DominionModel only exists on game 0.113.0+, and the game
        calls Assembly.GetTypes() on the mod dll, which throws if any type's base class is missing. ActsFromThePast.dll
        therefore never references this project; DreadLoader loads the dll by path, and only when DominionModel exists.
        Always compiled against the beta (0.113.0) install; on older games it is simply not loaded.
    -->
    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <LangVersion>14.0</LangVersion>
        <ImplicitUsings>true</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RootNamespace>ActsFromThePast.Dread</RootNamespace>
        <AssemblyName>ActsFromThePast.Dread</AssemblyName>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <NoWarn>$(NoWarn);MSB3270</NoWarn>
    </PropertyGroup>

    <Import Project="../local.props" Condition="Exists('../local.props')"/>

    <PropertyGroup>
        <Sts2Branch Condition="'$(Sts2Branch)' == ''">beta</Sts2Branch>
        <Sts2Path Condition="'$(Sts2Path)' == '' and '$(Sts2Branch)' == 'public'">$(Sts2PublicPath)</Sts2Path>
        <Sts2Path Condition="'$(Sts2Path)' == '' and '$(Sts2Branch)' == 'beta'">$(Sts2BetaPath)</Sts2Path>
        <Sts2Path Condition="'$(Sts2Path)' == ''">/home/hex3/.steam/steam/steamapps/common/Slay the Spire 2/</Sts2Path>
        <ModsPath Condition="'$(ModsPath)' == ''">$(Sts2Path)/mods/</ModsPath>
        <Sts2DataDir Condition="'$(Sts2DataDir)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">$(Sts2Path)/data_sts2_windows_x86_64</Sts2DataDir>
        <Sts2DataDir Condition="'$(Sts2DataDir)' == ''">$(Sts2Path)/data_sts2_linuxbsd_x86_64</Sts2DataDir>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="**/*.cs" Exclude="obj/**;bin/**"/>
    </ItemGroup>

    <ItemGroup Condition="Exists('$(Sts2DataDir)')">
        <Reference Include="0Harmony">
            <HintPath>$(Sts2DataDir)/0Harmony.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="sts2">
            <HintPath>$(Sts2DataDir)/sts2.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <!-- The main mod dll, for types the Dominions reuse (e.g. CuriosityPower). A plain file reference, not a ProjectReference:
         the main project builds this one after itself, so a project reference would be circular. Build the main project first. -->
    <ItemGroup>
        <Reference Include="ActsFromThePast">
            <HintPath>$(ModsPath)ActsFromThePast/ActsFromThePast.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <!-- No game install (CI): compile against the published reference assemblies of the game instead. -->
    <ItemGroup Condition="!Exists('$(Sts2DataDir)')">
        <PackageReference Include="lamali.StS2.RefLib" Version="0.113.0" ExcludeAssets="runtime" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Alchyr.Sts2.BaseLib" Version="3.4.7" PrivateAssets="All" ExcludeAssets="runtime"/>
    </ItemGroup>

    <!-- Deploys next to ActsFromThePast.dll, into the mods folder of both installs (the older one just never loads it). -->
    <Target Name="CopyDreadToModsFolder" AfterTargets="Build">
        <PropertyGroup>
            <_Primary>$(ModsPath)ActsFromThePast/</_Primary>
            <_MirrorBeta Condition="'$(Sts2BetaPath)' != '' and '$(Sts2BetaPath)' != '$(Sts2Path)' and Exists('$(Sts2BetaPath)')">$(Sts2BetaPath)/mods/ActsFromThePast/</_MirrorBeta>
            <_MirrorPublic Condition="'$(Sts2PublicPath)' != '' and '$(Sts2PublicPath)' != '$(Sts2Path)' and Exists('$(Sts2PublicPath)')">$(Sts2PublicPath)/mods/ActsFromThePast/</_MirrorPublic>
        </PropertyGroup>
        <ItemGroup>
            <_DreadFile Include="$(TargetPath)"/>
            <_DreadFile Include="$(TargetDir)$(TargetName).pdb" Condition="Exists('$(TargetDir)$(TargetName).pdb')"/>
        </ItemGroup>
        <Copy SourceFiles="@(_DreadFile)" DestinationFolder="$(_Primary)"/>
        <Copy SourceFiles="@(_DreadFile)" DestinationFolder="$(_MirrorBeta)" Condition="'$(_MirrorBeta)' != ''" ContinueOnError="true"/>
        <Copy SourceFiles="@(_DreadFile)" DestinationFolder="$(_MirrorPublic)" Condition="'$(_MirrorPublic)' != ''" ContinueOnError="true"/>
    </Target>
</Project>
